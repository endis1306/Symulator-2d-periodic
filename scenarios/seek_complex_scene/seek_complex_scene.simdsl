world {
  delta_t: 0.01;
  iterations: 3500;
  boundary_point: [100, 80];
  log_file: "logs/seek_complex_scene.log.jsonl";

  # ==================================================
  # DYNAMICZNY CEL (OFIARA)
  # ==================================================
  object "moving_target" {
    positionXY: [80, 55];
    velocityXY: [-0.7, 0.25];
    theta: 0.0;
    omega: 0.0;
    static: false;

    shape: circle(r = 3.0);

    bodyParams {
      drag_lin_forward: 0.02;
      drag_lin_side:    0.08;
      drag_rot:         0.02;
      I:                1.3;
      mass:             6.0;
    }

    engines: [];
    sensors: [];
    logic: static();
  }

  # ==================================================
  # SEEKER A – ten sam kształt i parametry
  # ==================================================
  object "seeker_A" {
    positionXY: [20, 30];
    velocityXY: [0, 0];
    theta: 0.6;
    omega: 0.0;
    static: false;

    shape: polygon(
      points = [
        [   6.000,    0.000],
        [   2.000,    1.200],
        [   1.000,    1.200],
        [   1.000,    4.000],
        [   2.000,    5.000],
        [   0.000,    6.000],
        [  -2.000,    5.000],
        [  -1.000,    4.000],
        [  -1.000,    1.200],
        [  -4.000,    1.200],
        [  -6.000,    0.000],
        [  -4.000,   -1.200],
        [  -1.000,   -1.200],
        [  -1.000,   -4.000],
        [  -2.000,   -5.000],
        [   0.000,   -6.000],
        [   2.000,   -5.000],
        [   1.000,   -4.000],
        [   1.000,   -1.200],
        [   2.000,   -1.200]
      ]
    );

    bodyParams {
      drag_lin_forward: 0.032;
      drag_lin_side:    0.35;
      drag_rot:         0.1;
      I:                0.35;
      mass:             3.0;
    }

    engines: [
      rotor(
        id = "A_engine_left",
        rotor_omega_max = 80.0,
        tau_motor = 0.01,
        k_thrust = 3.1e-5,
        angle_offset = 0.0,
        position_local = [0.000, 5.200]
      ),
      rotor(
        id = "A_engine_right",
        rotor_omega_max = 80.0,
        tau_motor = 0.01,
        k_thrust = 3.1e-5,
        angle_offset = 0.0,
        position_local = [0.000, -5.200]
      )
    ];

    sensors: [];
    logic: custom(
      logic_module = "sim.systems.logic.my_module",
      logic_function = "seek_control",
      target_id = "moving_target"
    );
  }

  # ==================================================
  # SEEKER B – ten sam kształt i parametry (podobne)
  # ==================================================
  object "seeker_B" {
    positionXY: [10, 55];
    velocityXY: [0, 0];
    theta: -1.8;
    omega: 0.0;
    static: false;

    shape: polygon(
      points = [
        [   6.000,    0.000],
        [   2.000,    1.200],
        [   1.000,    1.200],
        [   1.000,    4.000],
        [   2.000,    5.000],
        [   0.000,    6.000],
        [  -2.000,    5.000],
        [  -1.000,    4.000],
        [  -1.000,    1.200],
        [  -4.000,    1.200],
        [  -6.000,    0.000],
        [  -4.000,   -1.200],
        [  -1.000,   -1.200],
        [  -1.000,   -4.000],
        [  -2.000,   -5.000],
        [   0.000,   -6.000],
        [   2.000,   -5.000],
        [   1.000,   -4.000],
        [   1.000,   -1.200],
        [   2.000,   -1.200]
      ]
    );

    bodyParams {
      drag_lin_forward: 0.013;
      drag_lin_side:    0.17;
      drag_rot:         0.15;
      I:                0.28;
      mass:             1;
    }

    engines: [
      rotor(
        id = "B_engine_left",
        rotor_omega_max = 270.0,
        tau_motor = 0.01,
        k_thrust = 3.1e-5,
        angle_offset = 0.0,
        position_local = [0.000, 5.200]
      ),
      rotor(
        id = "B_engine_right",
        rotor_omega_max = 270.0,
        tau_motor = 0.01,
        k_thrust = 3.1e-5,
        angle_offset = 0.0,
        position_local = [0.000, -5.200]
      )
    ];

    sensors: [];
    logic: custom(
      logic_module = "sim.systems.logic.my_module",
      logic_function = "seek_control",
      target_id = "seeker_A"
    );
  }
}
